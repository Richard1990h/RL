# ──────────────────────────────────────────────────────────────
# Rally Live — environment configuration
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Never commit your real `.env` (it is gitignored).
# ──────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ───────────────────────────────────────────
# MySQL connection string used by Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/rally_live"

# JWT signing secret. MUST be 64+ random chars and must NOT contain
# "change-in-production" (the app refuses to start otherwise).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:4500"
NEXTAUTH_URL="http://localhost:4500"

# ── PayPal (OPTIONAL — needed for credit purchases/withdrawals) ─
PAYPAL_MODE="sandbox"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ── Google OAuth (OPTIONAL — "Sign in with Google") ───────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4500/api/auth/callback/google"

# ── Live streaming / WebRTC TURN (OPTIONAL) ───────────────────
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""

# ── RTMP ingest (OPTIONAL — local node-media-server) ──────────
RTMP_HTTP_PORT="8000"

# ── Storage / uploads (OPTIONAL — defaults to local dirs) ─────
UPLOAD_DIR=""
USER_STORAGE_ROOT=""
MAX_FILE_SIZE_MB="2048"

# ── Desktop bridge (OPTIONAL — admin desktop integration) ─────
BRIDGE_URL=""
BRIDGE_SECRET=""
ALLOWED_DEVICE_IDS=""

# ── Analytics / versioning (OPTIONAL) ─────────────────────────
NEXT_PUBLIC_GTAG_ID=""
NEXT_PUBLIC_WEB_VERSION="0.1.0"
MIN_SUPPORTED_WEB_VERSION="0.1.0"
