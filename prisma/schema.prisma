generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────
// USERS & AUTH
// ──────────────────────────────────────

enum UserRole {
  OWNER
  BUG_TESTER
  END_USER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  displayName   String   @unique
  passwordHash  String
  avatarUrl     String?  @db.Text
  bio           String?  @db.Text
  dateOfBirth   DateTime?
  role          UserRole @default(END_USER)
  isCreator     Boolean  @default(false)
  verifiedBadge Boolean  @default(false)
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  friendCount    Int      @default(0)
  lastActiveAt   DateTime?
  isPremium     Boolean  @default(false)
  isOwner       Boolean  @default(false)
  isBanned      Boolean  @default(false)
  isDeactivated Boolean  @default(false)
  preferences   Json?
  premiumUntil  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Wallet
  wallet        Wallet?

  // Content
  videos        Video[]
  series        Series[]
  liveStreams    LiveStream[]
  services      Service[]

  // Interactions
  comments      Comment[]
  commentLikes  CommentLike[]
  likes         Like[]
  sentMessages     Message[]   @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")

  // Social
  followers     Follow[]  @relation("Following")
  following     Follow[]  @relation("Followers")
  blockedUsers  Block[]   @relation("Blocker")
  blockedBy     Block[]   @relation("Blocked")

  // Notifications
  notifications Notification[]

  // Moderation
  reports       Report[]  @relation("Reporter")
  reportedBy    Report[]  @relation("Reported")
  moderatorOf   Moderator[]

  // Transactions
  transactions  Transaction[]

  // Live participation
  liveParticipants LiveParticipant[]

  // Service orders
  serviceOrdersBuyer  ServiceOrder[] @relation("Buyer")
  serviceOrdersSeller ServiceOrder[] @relation("Seller")

  // Subscriptions
  subscriptions Subscription[]

  // Sessions
  sessions      Session[]

  // Credit Ledger
  creditLedger  CreditLedger[]

  // Ad settings
  adSettings    AdSettings?

  // Custom ads
  customAds     CustomAd[]
  adImpressionCreator AdImpressionLog[] @relation("adImpressionCreator")

  // Bug reports
  bugReports    BugReport[]

  // Recordings
  recordings    Recording[]

  // Editor projects
  editorProjects EditorProject[]

  // Streaks
  streaksAsUser1 MessageStreak[] @relation("StreakUser1")
  streaksAsUser2 MessageStreak[] @relation("StreakUser2")

  // Stream Whitelist
  streamWhitelistOwned  StreamWhitelist[] @relation("StreamWhitelistOwner")
  streamWhitelistEntry  StreamWhitelist[] @relation("StreamWhitelistUser")
  fivemOwnedServers     FivemServer[]     @relation("FivemServerOwner")
  fivemMemberships      FivemServerMember[]
  fivemVipPurchases     FivemServerVipPurchase[]
  fivemWebsiteSubscriptions FivemWebsiteSubscription[]

  // Friends
  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsAsUser1     Friendship[]    @relation("FriendshipUser1")
  friendshipsAsUser2     Friendship[]    @relation("FriendshipUser2")
  friendTimeoutsAsOwner  FriendTimeout[] @relation("FriendTimeoutOwner")
  friendTimeoutsAsTarget FriendTimeout[] @relation("FriendTimeoutTarget")

  // Battle invitations
  sentBattleInvites      BattleInvitation[] @relation("SentBattleInvites")
  receivedBattleInvites  BattleInvitation[] @relation("ReceivedBattleInvites")

  @@index([email])
  @@index([username])
  @@index([displayName])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ──────────────────────────────────────
// WALLET & CREDITS
// ──────────────────────────────────────

model Wallet {
  id           String @id @default(uuid())
  userId       String @unique
  credits      Int    @default(0)
  totalEarned  Int    @default(0)
  totalSpent   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        TransactionType
  amountCents Int
  credits     Int      @default(0)
  description String   @db.Text
  status      TransactionStatus @default(PENDING)
  stripeId    String?
  paypalId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CREDIT_PURCHASE
  CREDIT_SPENT
  CREDIT_EARNED
  DONATION
  SUBSCRIPTION
  AD_REVENUE
  SERVICE_PAYMENT
  SERVICE_PAYOUT
  STREAK_BONUS
  CREDIT_TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ──────────────────────────────────────
// CREDIT LEDGER (double-entry)
// ──────────────────────────────────────

enum LedgerEntryType {
  PAYPAL_PURCHASE
  STRIPE_PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  SPEND
  WITHDRAW
  ADJUSTMENT
  REVERSAL
  ADMIN_GRANT
  DONATION_IN
  DONATION_OUT
  SERVICE_PAYMENT
  SERVICE_EARNING
  SERVICE_REFUND
  MESSAGE_COST
  PLATFORM_FEE_PENDING
  PLATFORM_FEE_SETTLED
  AD_PURCHASE
  AD_REFUND
  AD_IMPRESSION_EARNING
  AD_CREATOR_PAYOUT
  GAME_GIFT_OUT
  GAME_GIFT_IN
  GAME_HOST_CUT
  GAME_PAYOUT
}

model CreditLedger {
  id           String          @id @default(uuid())
  userId       String
  deltaCredits Int
  type         LedgerEntryType
  referenceId  String
  description  String?         @db.Text
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, referenceId])
  @@index([userId])
  @@index([referenceId])
  @@index([type])
  @@index([userId, type])
  @@index([createdAt])
}

model PlatformSettings {
  id                       String   @id @default("singleton")
  withdrawalFeePct         Int      @default(2)
  withdrawalFeeMinCents    Int      @default(25)
  purchaseFeePct           Int      @default(5)
  customAdPriceCredits     Int      @default(5000)  // submission fee
  customAdCostPerImpression Int     @default(1)      // credits deducted per impression
  customAdMinBalance       Int      @default(100)    // minimum credits to keep serving
  customAdMixPercent       Int      @default(50)     // % chance a custom ad plays (0-100)
  adPayoutDay              Int      @default(0)      // day of month for auto-payout (0 = manual only)
  updatedAt                DateTime @updatedAt
}

// ──────────────────────────────────────
// VIDEOS & SERIES
// ──────────────────────────────────────

model Video {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  thumbnailUrl    String?  @db.Text
  videoUrl        String?  @db.Text
  durationSec     Int      @default(0)
  creatorId       String
  views           Int      @default(0)
  impressions     Int      @default(0)
  likes           Int      @default(0)
  dislikes        Int      @default(0)
  commentsCount   Int      @default(0)
  commentsEnabled Boolean  @default(true)
  tags            Json     @default("[]")
  status          VideoStatus @default(PROCESSING)
  visibility      VideoVisibility @default(PUBLIC)
  seriesId        String?
  seriesOrder     Int?
  autoplayNextId  String?
  storagePath     String?  @db.Text
  resolutions     Json     @default("[]")
  uploadDate      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  series     Series?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  comments   Comment[]
  likesList  Like[]
  videoViews VideoView[]
  adImpressionLogs AdImpressionLog[]

  @@index([creatorId])
  @@index([seriesId])
  @@index([uploadDate])
  @@index([views])
}

model VideoView {
  id        String   @id @default(uuid())
  videoId   String
  userId    String?
  ipHash    String
  viewedAt  DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
  @@unique([videoId, ipHash])
  @@index([videoId])
  @@index([viewedAt])
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  FOLLOWERS_ONLY
}

model Series {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  coverUrl    String?  @db.Text
  creatorId   String
  totalEpisodes Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes Video[]

  @@index([creatorId])
}

// ──────────────────────────────────────
// COMMENTS & LIKES
// ──────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  text      String   @db.Text
  likes     Int      @default(0)
  parentId  String?
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]

  @@index([videoId])
  @@index([userId])
  @@index([createdAt])
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  isLike    Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

// ──────────────────────────────────────
// SOCIAL (FOLLOWS, BLOCKS)
// ──────────────────────────────────────

model Follow {
  id         String   @id @default(uuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ──────────────────────────────────────
// FRIENDS
// ──────────────────────────────────────

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model FriendTimeout {
  id        String   @id @default(uuid())
  ownerId   String
  targetId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  owner  User @relation("FriendTimeoutOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target User @relation("FriendTimeoutTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetId])
  @@index([ownerId])
  @@index([targetId])
}

// ──────────────────────────────────────
// MESSAGING (Snapchat-style)
// ──────────────────────────────────────

model Message {
  id           String        @id @default(uuid())
  senderId     String
  receiverId   String
  text         String?       @db.Text
  mediaUrl     String?       @db.Text
  mediaType    MessageMediaType?
  status       MessageStatus @default(SENT)
  isPrivate    Boolean       @default(false)
  deleteAfter  DeleteAfterMode @default(IMMEDIATELY)
  viewTimerSec Int?
  openedAt     DateTime?
  deletedForRecipientAt DateTime?
  creditCost   Int           @default(0)
  createdAt    DateTime      @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

enum MessageMediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MessageStatus {
  SENT
  DELIVERED
  OPENED
  DELETED
}

enum DeleteAfterMode {
  IMMEDIATELY
  AFTER_24H
  WHEN_BOTH_LEAVE
  NEVER
}

model MessageStreak {
  id          String   @id @default(uuid())
  user1Id     String
  user2Id     String
  streakDays  Int      @default(0)
  lastMessage DateTime @default(now())
  bonusesPaid Int      @default(0)
  createdAt   DateTime @default(now())

  user1 User @relation("StreakUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("StreakUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// ──────────────────────────────────────
// LIVE STREAMS & BATTLES
// ──────────────────────────────────────

model LiveStream {
  id              String   @id @default(uuid())
  hostId          String
  title           String
  tags            Json     @default("[]")
  viewerCount     Int      @default(0)
  peakViewers     Int      @default(0)
  isBattle        Boolean  @default(false)
  mode            LiveMode @default(STANDARD)
  status          LiveStatus @default(WAITING)
  roundTimeSec    Int      @default(0)
  minDonation     Int      @default(0)
  hostCutPercent  Int      @default(0)
  bgColor         String?
  bgImageUrl      String?  @db.Text
  streamKey       String?  @unique
  recordingPath   String?  @db.Text
  // Team battle settings
  teamMode        Boolean  @default(false)
  teamSize        Int      @default(1)  // Players per team (2v2, 3v3, 4v4)
  // Specific-gift mode: array of tier IDs that count for scoring
  scoringGiftTiers Json?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  host           User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants   LiveParticipant[]
  moderators     Moderator[]
  chatMessages   LiveChatMessage[]
  recordings     Recording[]
  powerUps       PowerUp[]
  battleInvites  BattleInvitation[]

  @@index([hostId])
  @@index([status])
  @@index([createdAt])
}

model Recording {
  id            String          @id @default(uuid())
  liveStreamId  String
  userId        String
  title         String
  filePath      String          @db.Text
  thumbnailUrl  String?         @db.Text
  durationSec   Int             @default(0)
  sizeBytes     BigInt          @default(0)
  status        RecordingStatus @default(PROCESSING)
  progress      Int             @default(0)
  createdAt     DateTime        @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveStreamId])
  @@index([userId])
  @@index([createdAt])
}

enum RecordingStatus {
  PROCESSING
  READY
  FAILED
}

model EditorProject {
  id          String   @id @default(uuid())
  userId      String
  mediaId     String
  mediaType   String   @default("recording") // "recording" or "video"
  title       String   @default("Untitled Project")
  editState   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mediaId])
  @@unique([userId, mediaId])
}

enum LiveMode {
  STANDARD
  TIMER_WARS
  TOWER_WARS
  ROOMS
  TRIVIA
  AUCTION
  SPIN_WHEEL
  LAST_STANDING
}

enum LiveStatus {
  WAITING
  LIVE
  ENDED
}

model LiveParticipant {
  id           String   @id @default(uuid())
  liveStreamId String
  userId       String
  role         ParticipantRole @default(VIEWER)
  status       ParticipantStatus @default(ACTIVE)
  team         String?  // "A" or "B" for team battles
  joinedAt     DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
  @@index([userId])
}

enum ParticipantRole {
  HOST
  GUEST
  VIEWER
}

enum ParticipantStatus {
  PENDING
  ACTIVE
  REJECTED
}

model LiveChatMessage {
  id           String   @id @default(uuid())
  liveStreamId String
  userId       String
  text         String   @db.Text
  isDonation   Boolean  @default(false)
  creditAmount Int      @default(0)
  createdAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  @@index([liveStreamId])
  @@index([createdAt])
}

model Moderator {
  id           String   @id @default(uuid())
  liveStreamId String
  userId       String
  createdAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveStreamId, userId])
}

// ──────────────────────────────────────
// MODERATION & REPORTS
// ──────────────────────────────────────

model Report {
  id         String     @id @default(uuid())
  reporterId String
  reportedId String
  reason     String     @db.Text
  type       ReportType
  contentId  String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

enum ReportType {
  USER
  VIDEO
  COMMENT
  LIVE_STREAM
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

// ──────────────────────────────────────
// SERVICES (Creator marketplace)
// ──────────────────────────────────────

model Service {
  id            String   @id @default(uuid())
  creatorId     String
  title         String
  description   String   @db.Text
  category      ServiceCategory
  priceCredits  Int
  deliveryDays  Int      @default(7)
  maxOrders     Int?
  activeOrders  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  ServiceOrder[]

  @@index([creatorId])
  @@index([category])
}

enum ServiceCategory {
  COACHING
  VIDEO_REVIEW
  CUSTOM_CONTENT
  SHOUTOUT
  COLLABORATION
  OTHER
}

model ServiceOrder {
  id         String      @id @default(uuid())
  serviceId  String
  buyerId    String
  sellerId   String
  status     OrderStatus @default(PENDING)
  credits    Int
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  buyer   User    @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([buyerId])
  @@index([sellerId])
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

// ──────────────────────────────────────
// SUBSCRIPTIONS & ADS
// ──────────────────────────────────────

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      SubscriptionPlan
  status    SubStatus @default(ACTIVE)
  stripeSubId String?
  startDate DateTime @default(now())
  endDate   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum SubscriptionPlan {
  PREMIUM
}

enum SubStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

model AdSettings {
  id              String  @id @default(uuid())
  userId          String  @unique
  adsPerVideo     Int     @default(1)
  adsPerLiveHour  Int     @default(2)
  creditsToSkip   Int     @default(200)
  revenueSharePct Int     @default(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomAd {
  id              String    @id @default(uuid())
  userId          String
  title           String
  videoUrl        String    @db.Text
  durationSec     Int
  status          String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, PAUSED, EXPIRED
  creditsPaid     Int
  impressions     Int       @default(0)
  maxImpressions  Int       @default(0) // 0 = unlimited
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  impressionLogs AdImpressionLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AdImpressionLog {
  id                  String   @id @default(uuid())
  adId                String
  videoId             String?
  creatorId           String?
  totalCredits        Int          // total cost per impression
  creatorShareCredits Int          // creator's cut
  platformShareCredits Int         // platform's cut
  creatorSharePct     Int          // the % at time of impression
  paidOut             Boolean  @default(false)
  paidOutAt           DateTime?
  createdAt           DateTime @default(now())

  ad      CustomAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  creator User?    @relation("adImpressionCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([adId])
  @@index([videoId])
  @@index([creatorId])
  @@index([paidOut])
  @@index([createdAt])
}

// ──────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      NotificationType
  message   String   @db.Text
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  DONATION
  MESSAGE
  LIVE_START
  SUBSCRIPTION
  SERVICE_ORDER
  SYSTEM
  STREAK_BONUS
  FRIEND_REQUEST
  FRIEND_ACCEPT
  PRIVATE_MESSAGE
}

// ──────────────────────────────────────
// BUG REPORTS
// ──────────────────────────────────────

model BugReport {
  id          String       @id @default(uuid())
  userId      String
  username    String
  displayName String
  title       String
  description String       @db.Text
  page        String?
  status      BugStatus    @default(OPEN)
  diagnosis   String?      @db.Text
  upgradeRequest String?   @db.Text
  fixPlan     String?      @db.Text
  fixResult   String?      @db.Text
  testResult  String?      @db.Text
  adminNotes  String?      @db.Text
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum BugStatus {
  OPEN
  INVESTIGATING
  DIAGNOSED
  FIXING
  FIXED
  TESTING
  RESOLVED
  FAILED
  DISMISSED
}

// ──────────────────────────────────────
// STREAM WHITELIST
// ──────────────────────────────────────

enum FivemWhitelistDepartment {
  POLICE
  EMS
  FIREFIGHTER
  JUDGE
  LAWYER
}

enum FivemWhitelistStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FivemServerMemberRole {
  ADMIN
  MODERATOR
  USER
}

enum FivemServerMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

model FivemWhitelistApplication {
  id               String                   @id @default(uuid())
  displayName      String
  discordTag       String
  email            String?
  age              Int
  timezone         String
  department       FivemWhitelistDepartment
  availability     String                   @db.Text
  experience       String                   @db.Text
  scenarioResponse String                   @db.Text
  motivation       String                   @db.Text
  knowsRules       Boolean                  @default(false)
  agreesToPolicy   Boolean                  @default(false)
  hasWorkingMic    Boolean                  @default(false)
  status           FivemWhitelistStatus     @default(PENDING)
  reviewerNotes    String?                  @db.Text
  reviewedAt       DateTime?
  reviewedBy       String?
  ipHash           String?
  userAgent        String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status])
  @@index([discordTag])
  @@index([createdAt])
}

model FivemServer {
  id                 String             @id @default(uuid())
  ownerId            String
  slug               String             @unique
  name               String
  websiteName        String
  summary            String?            @db.Text
  description        String?            @db.Text
  logoUrl            String?            @db.Text
  coverUrl           String?            @db.Text
  discordInviteUrl   String?            @db.Text
  discordGuildId     String?
  discordMemberCount Int                @default(0)
  onlinePlayers      Int                @default(0)
  maxPlayers         Int                @default(64)
  whitelistOpen      Boolean            @default(false)
  isPublished        Boolean            @default(true)
  tags               Json?
  settings           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner   User                @relation("FivemServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members FivemServerMember[]
  jobs    FivemServerJob[]
  pages   FivemServerPage[]
  vipPackages FivemServerVipPackage[]
  vipPurchases FivemServerVipPurchase[]
  websiteSubscriptions FivemWebsiteSubscription[]
  bugReports FivemBugReport[]
  suggestions FivemSuggestion[]

  @@index([ownerId])
  @@index([isPublished])
}

model FivemServerMember {
  id        String                 @id @default(uuid())
  serverId  String
  userId    String
  role      FivemServerMemberRole  @default(USER)
  status    FivemServerMemberStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@index([serverId, role])
}

model FivemServerJob {
  id            String   @id @default(uuid())
  serverId      String
  title         String
  description   String?  @db.Text
  whitelistOnly Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, isActive])
}

model FivemServerPage {
  id        String   @id @default(uuid())
  serverId  String
  slug      String
  title     String
  content   Json?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, slug])
  @@index([serverId, sortOrder])
}

model FivemServerVipPackage {
  id           String   @id @default(uuid())
  serverId     String
  name         String
  description  String?  @db.Text
  priceCredits Int
  durationDays Int      @default(30)
  benefits     Json?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  purchases FivemServerVipPurchase[]

  @@index([serverId, isActive])
}

model FivemServerVipPurchase {
  id           String   @id @default(uuid())
  serverId     String
  packageId    String
  userId       String
  creditsPaid  Int
  startsAt     DateTime @default(now())
  expiresAt    DateTime
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  server  FivemServer            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  package FivemServerVipPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serverId, userId, status])
  @@index([packageId])
}

model FivemWebsiteSubscription {
  id              String   @id @default(uuid())
  userId          String
  serverId        String   @unique
  status          String   @default("ACTIVE")
  amountCents     Int
  billingPeriod   String   @default("MONTHLY")
  paypalOrderId   String?
  paypalCaptureId String?
  startedAt       DateTime @default(now())
  nextBillingAt   DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([nextBillingAt])
}

model StreamWhitelist {
  id            String   @id @default(uuid())
  userId        String   // the streamer who owns this whitelist
  whitelistedId String   // the user being whitelisted
  createdAt     DateTime @default(now())

  user        User @relation("StreamWhitelistOwner", fields: [userId], references: [id], onDelete: Cascade)
  whitelisted User @relation("StreamWhitelistUser", fields: [whitelistedId], references: [id], onDelete: Cascade)

  @@unique([userId, whitelistedId])
  @@index([userId])
}

// ──────────────────────────────────────
// POWER-UPS
// ──────────────────────────────────────

enum PowerUpType {
  BOOSTING_GLOVE    // 5x score multiplier
  MAGIC_MIST        // Hide opponent's score
  STUN_HAMMER       // Visual distortion effect
  TIME_MAKER        // Add time to timer
}

model PowerUp {
  id          String      @id @default(uuid())
  streamId    String
  userId      String
  targetId    String?     // Player affected (null for stream-wide effects like TIME_MAKER)
  type        PowerUpType
  costCredits Int
  activatedAt DateTime    @default(now())
  expiresAt   DateTime?   // null for instant effects

  liveStream  LiveStream  @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([userId])
  @@index([streamId, type])
}

// ──────────────────────────────────────
// BATTLE INVITATIONS
// ──────────────────────────────────────

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model BattleInvitation {
  id          String       @id @default(uuid())
  streamId    String
  senderId    String
  receiverId  String
  status      InviteStatus @default(PENDING)
  message     String?      @db.Text
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  liveStream  LiveStream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  sender      User         @relation("SentBattleInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("ReceivedBattleInvites", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId])
  @@index([streamId])
}

// ──────────────────────────────────────
// FIVEM BUG REPORTS (in-game)
// ──────────────────────────────────────

model FivemBugReport {
  id            String   @id @default(uuid())
  serverId      String
  playerName    String
  playerId      String?
  title         String
  description   String   @db.Text
  stepsToRepro  String   @db.Text
  expected      String?  @db.Text
  severity      String   @default("MEDIUM")
  status        String   @default("OPEN")
  location      String?
  adminNotes    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([createdAt])
}

// ──────────────────────────────────────
// FIVEM SUGGESTIONS (in-game)
// ──────────────────────────────────────

model FivemSuggestion {
  id            String   @id @default(uuid())
  serverId      String
  playerName    String
  playerId      String?
  title         String
  description   String   @db.Text
  howItWorks    String   @db.Text
  whyItsGood    String?  @db.Text
  priority      String   @default("NICE_TO_HAVE")
  status        String   @default("NEW")
  adminNotes    String?  @db.Text
  votes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server FivemServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([createdAt])
}

// ──────────────────────────────────────
// FIVEM ADMIN COMMENTS (on bugs/suggestions)
// ──────────────────────────────────────

model FivemAdminComment {
  id          String   @id @default(uuid())
  serverId    String
  targetType  String   // "BUG" or "SUGGESTION"
  targetId    String   // bug or suggestion ID
  authorName  String
  authorId    String
  text        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([serverId, targetType, targetId])
  @@index([createdAt])
}
